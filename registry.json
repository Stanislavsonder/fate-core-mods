      "strings": {
        "ar": {
          "name": "العلاقات",
          "short": "تتبّع علاقات شخصيتك",
          "full": "تتبّع علاقات شخصيتك: من هم وما الذي يربطهم بها."
        },
        "be": {
          "name": "Адносіны",
          "short": "Адсочвайце адносіны вашага персанажа",
          "full": "Адсочвайце адносіны вашага персанажа: хто гэтыя людзі і што іх звязвае."
        },
        "bn": {
          "name": "সম্পর্কসমূহ",
          "short": "আপনার চরিত্রের সম্পর্কগুলি ট্র্যাক করুন",
          "full": "আপনার চরিত্রের সম্পর্কগুলি ট্র্যাক করুন: তারা কে এবং তাদের সংযুক্ত করে কী।"
        },
        "cs": {
          "name": "Vztahy",
          "short": "Sledujte vztahy své postavy",
          "full": "Sledujte vztahy své postavy: kdo tito lidé jsou a co je spojuje."
        },
        "da": {
          "name": "Relationer",
          "short": "Hold styr på din karakters relationer",
          "full": "Hold styr på din karakters relationer: hvem de er, og hvad der forbinder dem."
        },
        "de": {
          "name": "Beziehungen",
          "short": "Verfolge die Beziehungen deines Charakters",
          "full": "Verfolge die Beziehungen deines Charakters: wer sie sind und was sie verbindet."
        },
        "el": {
          "name": "Σχέσεις",
          "short": "Παρακολουθήστε τις σχέσεις του χαρακτήρα σας",
          "full": "Παρακολουθήστε τις σχέσεις του χαρακτήρα σας: ποιοι είναι και τι τους συνδέει."
        },
        "en": {
          "name": "Relationships",
          "short": "Track your character's relationships",
          "full": "Track your character's relationships: who they are, and what connects them."
        },
        "es": {
          "name": "Relaciones",
          "short": "Registra las relaciones de tu personaje",
          "full": "Registra las relaciones de tu personaje: quiénes son y qué los conecta."
        },
        "fa": {
          "name": "روابط",
          "short": "روابط شخصیت خود را دنبال کنید",
          "full": "روابط شخصیت خود را دنبال کنید: چه کسانی هستند و چه چیزی آن‌ها را به هم پیوند می‌دهد."
        },
        "fi": {
          "name": "Suhteet",
          "short": "Seuraa hahmosi suhteita",
          "full": "Seuraa hahmosi suhteita: keitä he ovat ja mikä yhdistää heidät."
        },
        "fr": {
          "name": "Relations",
          "short": "Suivez les relations de votre personnage",
          "full": "Suivez les relations de votre personnage : qui elles sont et ce qui les relie."
        },
        "he": {
          "name": "קשרים",
          "short": "עקוב אחר הקשרים של הדמות שלך",
          "full": "עקוב אחר הקשרים של הדמות שלך: מי הם ומה מחבר ביניהם."
        },
        "hi": {
          "name": "संबंध",
          "short": "अपने पात्र के संबंधों को ट्रैक करें",
          "full": "अपने पात्र के संबंधों को ट्रैक करें: वे कौन हैं और उन्हें क्या जोड़ता है।"
        },
        "id": {
          "name": "Hubungan",
          "short": "Lacak hubungan karakter Anda",
          "full": "Lacak hubungan karakter Anda: siapa mereka dan apa yang menghubungkan mereka."
        },
        "it": {
          "name": "Relazioni",
          "short": "Tieni traccia delle relazioni del tuo personaggio",
          "full": "Tieni traccia delle relazioni del tuo personaggio: chi sono e cosa li collega."
        },
        "ja": {
          "name": "人間関係",
          "short": "キャラクターの人間関係を記録します",
          "full": "キャラクターの人間関係を記録しましょう。相手が誰で、どうつながっているかを管理できます。"
        },
        "ko": {
          "name": "인간관계",
          "short": "캐릭터의 인간관계를 기록하세요",
          "full": "캐릭터의 인간관계를 기록하세요: 그들이 누구인지, 그리고 무엇이 그들을 연결하는지."
        },
        "nl": {
          "name": "Relaties",
          "short": "Houd de relaties van je personage bij",
          "full": "Houd de relaties van je personage bij: wie ze zijn en wat hen verbindt."
        },
        "no": {
          "name": "Relasjoner",
          "short": "Hold oversikt over karakterens relasjoner",
          "full": "Hold oversikt over karakterens relasjoner: hvem de er og hva som knytter dem sammen."
        },
        "pl": {
          "name": "Relacje",
          "short": "Śledź relacje swojej postaci",
          "full": "Śledź relacje swojej postaci: kim są te osoby i co je łączy."
        },
        "pt": {
          "name": "Relações",
          "short": "Acompanhe as relações da sua personagem",
          "full": "Acompanhe as relações da sua personagem: quem são e o que as liga."
        },
        "ro": {
          "name": "Relații",
          "short": "Urmărește relațiile personajului tău",
          "full": "Urmărește relațiile personajului tău: cine sunt acestea și ce le leagă."
        },
        "ru": {
          "name": "Отношения",
          "short": "Отслеживайте отношения вашего персонажа",
          "full": "Отслеживайте отношения вашего персонажа: кто эти люди и что их связывает."
        },
        "sv": {
          "name": "Relationer",
          "short": "Håll koll på din karaktärs relationer",
          "full": "Håll koll på din karaktärs relationer: vilka de är och vad som förenar dem."
        },
        "sw": {
          "name": "Uhusiano",
          "short": "Fuatilia uhusiano wa mhusika wako",
          "full": "Fuatilia uhusiano wa mhusika wako: walio nao na kinachowaunganisha."
        },
        "th": {
          "name": "ความสัมพันธ์",
          "short": "บันทึกความสัมพันธ์ของตัวละครของคุณ",
          "full": "บันทึกความสัมพันธ์ของตัวละครของคุณ: พวกเขาคือใครและอะไรที่เชื่อมโยงพวกเขา"
        },
        "tr": {
          "name": "İlişkiler",
